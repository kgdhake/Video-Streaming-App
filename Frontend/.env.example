# GetStream API Key (same as backend STREAM_API_KEY)
VITE_STREAM_API_KEY=your_getstream_api_key

# Optional: Set this only if your backend is hosted separately (e.g. on Render or Railway)
# If using all-in-one Vercel deployment, leave it empty or omit it.
# VITE_API_URL=https://your-backend.onrender.com/api
