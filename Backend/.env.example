# Backend Environment Variables
PORT=5001
MONGO_URL=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/streaming_db?retryWrites=true&w=majority
JWT_SECRET_KEY=your_super_secret_jwt_key
STREAM_API_KEY=your_getstream_api_key
STREAM_API_SECRET=your_getstream_api_secret
NODE_ENV=production

# Frontend URL (your Vercel app URL for CORS, e.g. https://your-project.vercel.app)
CLIENT_URL=https://your-app.vercel.app
